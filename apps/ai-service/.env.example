AI_ENV=local
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8001
AI_PROVIDER=mock
AI_MODEL=campusfit-mock
AI_SCOPE_MODEL=
AI_TIMEOUT_SECONDS=12
# 兼容 OpenAI 协议网关示例：如接入自建或第三方兼容网关，可填写其 /v1 地址。
# 例如部署环境可配置为 https://token-plan-cn.xiaomimimo.com/v1，密钥请通过运行环境注入，不要提交到仓库。
OPENAI_BASE_URL=
OPENAI_API_KEY=
LOG_LEVEL=INFO
LOG_DIR=logs
