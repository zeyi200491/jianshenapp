{
  "name": "@campusfit/web",
  "private": true,
  "scripts": {
    "predev": "npm --prefix ../../packages/shared run build",
    "prebuild": "npm --prefix ../../packages/shared run build",
    "prelint": "npm --prefix ../../packages/shared run build",
    "pretypecheck": "npm --prefix ../../packages/shared run build",
    "dev": "node ../../scripts/run-typescript-cli.cjs --module=next/dist/bin/next dev --port 3200",
    "build": "node ../../scripts/run-typescript-cli.cjs --module=next/dist/bin/next build",
    "start": "node ../../scripts/run-typescript-cli.cjs --module=next/dist/bin/next start --port 3200",
    "lint": "node ../../scripts/run-typescript-cli.cjs -p tsconfig.json --noEmit",
    "typecheck": "node ../../scripts/run-typescript-cli.cjs -p tsconfig.json --noEmit",
    "test": "node ./tests/smoke.test.mjs",
    "test:ux": "node ./tests/ux-smoke.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@campusfit/shared": "workspace:*",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
